# Proxy TCP de borde: publica el objetivo en 127.0.0.1 sin darle salida a Internet.
# Digest fijado (V-06): el tag `3.20` puede moverse, el digest no.
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

RUN apk add --no-cache socat

# V-07: el proxy no necesita privilegios ni root para escuchar en 8080.
USER 65534:65534

EXPOSE 8080

ENTRYPOINT ["socat"]
CMD ["TCP-LISTEN:8080,fork,reuseaddr", "TCP:target-app:8080"]
